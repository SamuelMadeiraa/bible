{
  "name": "bible-acf-studio",
  "version": "3.6.1",
  "description": "Projeção de versículos (ACF) e mídias ao vivo, com tela de operador e tela de projeção",
  "main": "main.js",
  "author": "Samuel Madeira",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis"
  },
  "build": {
    "appId": "com.samuelmadeira.bibleacfstudio",
    "productName": "BibleLyrics",
    "files": [
      "main.js",
      "preload.js",
      "analytics.js",
      "biblioteca.js",
      "atualizacao.js",
      "app/**/*",
      "node_modules/@fontsource/**/*",
      "package.json",
      "node_modules/dockview-core/**/*",
      "node_modules/qrcode-generator/**/*",
      "node_modules/mp4-muxer/build/**/*",
      "node_modules/mp4-muxer/package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BibleLyrics",
      "artifactName": "BibleLyrics-Setup-${version}.${ext}"
    },
    "directories": {
      "buildResources": "build"
    },
    "fileAssociations": [
      {
        "ext": "bible",
        "name": "BibleLyrics",
        "description": "Preset ou backup do BibleLyrics",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "SamuelMadeiraa",
        "repo": "bible"
      }
    ],
    "portable": {
      "artifactName": "BibleLyrics-${version}-portatil.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "dockview-core": "^8.3.1",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "mp4-muxer": "^5.2.2",
    "qrcode-generator": "^2.0.4"
  },
  "productName": "BibleLyrics"
}
